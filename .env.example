# Copy to .env and fill in your keys:  cp .env.example .env
# Generation can run on Anthropic OR OpenAI — set whichever key(s) you have, and
# the answer-model dropdown shows that provider's models. OPENAI_API_KEY is also
# required for embeddings (Anthropic has no embeddings endpoint), so retrieval
# needs it regardless of which provider answers.
ANTHROPIC_API_KEY=sk-ant-...   # Claude generation + LLM judge (optional if answering with OpenAI)
OPENAI_API_KEY=sk-...          # embeddings (required) + optional OpenAI answer models
PINECONE_API_KEY=pcsk-...

# Optional overrides (defaults shown)
# ANTHROPIC_CHAT_MODEL=claude-opus-4-8    # default answer model (dropdown leads with this)
# ANTHROPIC_JUDGE_MODEL=claude-sonnet-4-6 # LLM judge (separate model = separate rate-limit bucket)
# ANTHROPIC_MAX_TOKENS=2048               # cap on generated answer length
# Comma-separated model menus, filtered at runtime by which API key is set:
# ANTHROPIC_CHAT_MODELS=claude-opus-4-8,claude-opus-4-7,claude-sonnet-4-6,claude-haiku-4-5
# OPENAI_CHAT_MODELS=gpt-4o,gpt-4o-mini,gpt-4.1,gpt-4.1-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# PINECONE_INDEX_NAME=fintech-10k
# RERANK_ONNX_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# SEC_USER_AGENT=GenAcademy Research your-email@example.com
